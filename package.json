{
    "name": "flight-finder",
    "version": "1.0.0",
    "description": "Flight Finder - MERN Stack Flight Booking Application",
    "main": "server/index.js",
    "type": "module",
    "scripts": {
        "start": "node server/index.js",
        "server": "node server/index.js",
        "client": "npm start --prefix client",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "install-all": "npm install && cd client && npm install && cd ../server && npm install",
        "build": "cd client && npm run build",
        "render-build": "npm install && cd client && npm install && npm run build && cd .. && mkdir -p server/public && cp -r client/build/* server/public/ && cd server && npm install"
    },
    "dependencies": {
        "bcrypt": "^5.1.0",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "mongoose": "^7.4.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "flight",
        "booking",
        "mern",
        "react",
        "nodejs",
        "express",
        "mongodb"
    ],
    "author": "",
    "license": "ISC"
}